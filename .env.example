# Modo de desarrollo con MSW. Ponlo en false para usar las APIs reales.
VITE_USE_MOCKS=true

# Autenticación: "mock" (login simulado) o "cognito" (login real, AUTH-01).
# Con "cognito" hay que llenar el User Pool y el App Client (sin secreto).
# La región sale del propio User Pool ID (us-east-1_xxxx).
VITE_AUTH_MODE=mock
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# URLs base de las APIs (API Gateway) por microservicio.
# En Amplify se configuran como Environment variables de la rama.
# Modo mixto: con VITE_USE_MOCKS=true, el servicio que tenga URL usa su API real
# y el resto sigue simulado. Ej.: solo VITE_API_NOTIFICACIONES con la URL de dev.
VITE_API_USUARIOS=
VITE_API_CURSOS=
VITE_API_CONTENIDOS=
VITE_API_EVALUACIONES=
VITE_API_CALIFICACIONES=
VITE_API_NOTIFICACIONES=
